# Swift build artifacts
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*secret*
*credential*

# macOS application build
*.app/
